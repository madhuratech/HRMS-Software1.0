{
  "version": 2,
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "https://madhura-hrm.onrender.com/app/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://madhura-hrm.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://madhura-hrm.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
